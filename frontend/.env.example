# Public site URL, used for canonical, hreflang, sitemap and Open Graph links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mock data until the backend is connected (issue #41). Set to false to use the REST API.
NEXT_PUBLIC_USE_MOCK=true
NEXT_PUBLIC_API_URL=http://localhost:8080

# Ownership tokens from Google Search Console and Bing Webmaster Tools (HTML tag method).
# Bing also feeds ChatGPT search and Copilot. Leave empty until the site is registered.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Error reports of the browser to Sentry (#56). Empty: off. The DSN is public by design (it can only send
# events); in Sentry turn on "Prevent storing of IP addresses" for the project.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_RELEASE=
