# Public site URL, used for canonical, hreflang, sitemap and Open Graph links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sample data ("Nümunə data" banner, noindex) only when set to true: demos and CI builds without a
# backend. Unset or false: the real REST API at NEXT_PUBLIC_API_URL (#41).
NEXT_PUBLIC_USE_MOCK=false
NEXT_PUBLIC_API_URL=http://localhost:8080
# Server only, never NEXT_PUBLIC. Shared secret with the API (JEPARLA_FRONTEND_TOKEN, 32+ bytes): the
# frontend server then names each visitor to the API rate limits (sign-in, search). Optional locally.
JEPARLA_FRONTEND_TOKEN=

# Ownership tokens from Google Search Console and Bing Webmaster Tools (HTML tag method).
# Bing also feeds ChatGPT search and Copilot. Leave empty until the site is registered.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
