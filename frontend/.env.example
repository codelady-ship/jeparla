# Public site URL, used for canonical, hreflang, sitemap and Open Graph links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sample data ("Nümunə data" banner, noindex) only when set to true: demos and CI builds without a
# backend. Unset or false: the real REST API at NEXT_PUBLIC_API_URL (#41).
NEXT_PUBLIC_USE_MOCK=false
NEXT_PUBLIC_API_URL=http://localhost:8080
# Server only, never NEXT_PUBLIC. Shared secret with the API (JEPARLA_FRONTEND_TOKEN, 32+ bytes): the
# frontend server then names each visitor to the API rate limits (sign-in, search). Optional locally.
JEPARLA_FRONTEND_TOKEN=

# Support contact shown on /help (#167); same values as the API's JEPARLA_SUPPORT_EMAIL / _URL.
# Empty: the help page says that no support address has been published yet.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_URL=

# The operator named in the legal pages (/legal/*, #57): legal name (e.g. the sole trader's full name or the
# LLC), VOEN (10 digits) and registered address. Filled by the owner; empty values show a visible
# "[owner's details]" marker on the page. Production compose: JEPARLA_OPERATOR_NAME / _TAX_ID / _ADDRESS.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_TAX_ID=
NEXT_PUBLIC_OPERATOR_ADDRESS=

# Ownership tokens from Google Search Console and Bing Webmaster Tools (HTML tag method).
# Bing also feeds ChatGPT search and Copilot. Leave empty until the site is registered.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Error reports of the browser to Sentry (#56). Empty: off. The DSN is public by design (it can only send
# events); in Sentry turn on "Prevent storing of IP addresses" for the project.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_RELEASE=
