{
  "$description": "Jeparla design tokens. Source of truth for frontend/src/app/tokens.css (npm run tokens). Every pair below must pass WCAG AA: python3 tools/contrast.py docs/design/tokens.json",
  "color": {
    "light": {
      "bg": "#F7F3EA",
      "surface": "#FFFFFF",
      "surface-muted": "#EFE8DA",
      "border": "#E2D9C6",
      "input": "#8F8470",
      "text": "#292929",
      "text-muted": "#5E5A52",
      "primary": "#16251F",
      "on-primary": "#F7F3EA",
      "accent": "#C5A15A",
      "on-accent": "#16251F",
      "accent-text": "#7A5B1F",
      "ring": "#8C6A26",
      "danger": "#B42318",
      "on-danger": "#FFFFFF",
      "success": "#1D6A43",
      "warning": "#8A5300"
    },
    "dark": {
      "bg": "#0E1814",
      "surface": "#16251F",
      "surface-muted": "#1F3129",
      "border": "#2B3F36",
      "input": "#6D8479",
      "text": "#F7F3EA",
      "text-muted": "#B9B3A6",
      "primary": "#C5A15A",
      "on-primary": "#16251F",
      "accent": "#C5A15A",
      "on-accent": "#16251F",
      "accent-text": "#D8B977",
      "ring": "#D8B977",
      "danger": "#F2857B",
      "on-danger": "#16251F",
      "success": "#6CC896",
      "warning": "#E5B45A"
    }
  },
  "font": {
    "heading": "Playfair Display",
    "body": "Inter"
  },
  "radius": "0.5rem",
  "motion": {
    "duration": {
      "fast": "150ms",
      "base": "300ms",
      "slow": "600ms",
      "reveal": "800ms",
      "zoom": "1200ms",
      "morph": "500ms"
    },
    "easing": {
      "luxe": "cubic-bezier(0.22, 1, 0.36, 1)",
      "standard": "cubic-bezier(0.4, 0, 0.2, 1)",
      "in-out": "cubic-bezier(0.65, 0, 0.35, 1)"
    },
    "reveal-distance": "24px",
    "reveal-stagger": "80ms"
  },
  "pairs": [
    ["light-text", "light-bg"],
    ["light-text-muted", "light-bg"],
    ["light-accent-text", "light-bg"],
    ["light-danger", "light-bg"],
    ["light-success", "light-bg"],
    ["light-warning", "light-bg"],
    ["light-input", "light-bg", "ui"],
    ["light-ring", "light-bg", "ui"],
    ["light-text", "light-surface"],
    ["light-text-muted", "light-surface"],
    ["light-accent-text", "light-surface"],
    ["light-danger", "light-surface"],
    ["light-success", "light-surface"],
    ["light-warning", "light-surface"],
    ["light-input", "light-surface", "ui"],
    ["light-ring", "light-surface", "ui"],
    ["light-text", "light-surface-muted"],
    ["light-text-muted", "light-surface-muted"],
    ["light-accent-text", "light-surface-muted"],
    ["light-danger", "light-surface-muted"],
    ["light-success", "light-surface-muted"],
    ["light-warning", "light-surface-muted"],
    ["light-input", "light-surface-muted", "ui"],
    ["light-ring", "light-surface-muted", "ui"],
    ["light-on-primary", "light-primary"],
    ["light-on-accent", "light-accent"],
    ["light-on-danger", "light-danger"],
    ["light-primary", "light-bg", "ui"],
    ["dark-text", "dark-bg"],
    ["dark-text-muted", "dark-bg"],
    ["dark-accent-text", "dark-bg"],
    ["dark-danger", "dark-bg"],
    ["dark-success", "dark-bg"],
    ["dark-warning", "dark-bg"],
    ["dark-input", "dark-bg", "ui"],
    ["dark-ring", "dark-bg", "ui"],
    ["dark-text", "dark-surface"],
    ["dark-text-muted", "dark-surface"],
    ["dark-accent-text", "dark-surface"],
    ["dark-danger", "dark-surface"],
    ["dark-success", "dark-surface"],
    ["dark-warning", "dark-surface"],
    ["dark-input", "dark-surface", "ui"],
    ["dark-ring", "dark-surface", "ui"],
    ["dark-text", "dark-surface-muted"],
    ["dark-text-muted", "dark-surface-muted"],
    ["dark-accent-text", "dark-surface-muted"],
    ["dark-danger", "dark-surface-muted"],
    ["dark-success", "dark-surface-muted"],
    ["dark-warning", "dark-surface-muted"],
    ["dark-input", "dark-surface-muted", "ui"],
    ["dark-ring", "dark-surface-muted", "ui"],
    ["dark-on-primary", "dark-primary"],
    ["dark-on-accent", "dark-accent"],
    ["dark-on-danger", "dark-danger"],
    ["dark-primary", "dark-bg", "ui"],
    ["dark-accent", "dark-bg", "ui"]
  ]
}
