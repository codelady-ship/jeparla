# Jeparla production environment (deploy/docker-compose.prod.yml). docs/deploy.md says where each value
# comes from.
#
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env && nano deploy/.env
#
# deploy/.env lives only on the VM (gitignored). Never commit it, never paste it into an issue or a chat.
# Passwords and keys: letters and digits only (some are embedded in URLs). Generate each one separately:
#   openssl rand -hex 32

# --- Object storage mode --------------------------------------------------------
# local-s3: product images and uploads in the S3 service on this VM (default, needs no card).
# Empty (COMPOSE_PROFILES=): Cloudflare R2; then fill the R2 block at the end of this file.
COMPOSE_PROFILES=local-s3

# --- Domains (Caddy, HTTPS) -----------------------------------------------------
# One free DuckDNS name pointing at the VM's public IP (docs/deploy.md, section 5); DuckDNS answers every
# sub-name (api., s3.) with the same IP. Fallback without an account: <ip-with-dashes>.sslip.io, e.g.
# SITE_DOMAIN=141-147-1-2.sslip.io, API_DOMAIN=api.141-147-1-2.sslip.io, S3_DOMAIN=s3.141-147-1-2.sslip.io.
# The site origin https://SITE_DOMAIN is also the API's CORS origin and the base of links in emails.
SITE_DOMAIN=jeparla.duckdns.org
API_DOMAIN=api.jeparla.duckdns.org
# Images and uploads (local-s3 mode).
S3_DOMAIN=s3.jeparla.duckdns.org

# --- Frontend (built on the VM, docs/deploy.md section 9) --------------------------
# Shared secret of the Next.js server and the API (#41): rate limits count visitors, not the site server.
# gen-secrets.sh fills it. openssl rand -hex 32
JEPARLA_FRONTEND_TOKEN=
# Search Console / Bing Webmaster ownership tokens (HTML tag method, only the content value). Empty until
# the site is registered (section 14). A change needs a new site build: deploy/scripts/deploy.sh.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# IndexNow key (#62, docs/geo-check.md): 32 letters and digits, e.g. openssl rand -hex 16. Used by the API (submits
# changed product and store pages) and served by the site at https://SITE_DOMAIN/<key>.txt. Empty: off.
# A change needs only a restart: deploy/scripts/deploy.sh.
JEPARLA_INDEXNOW_KEY=
# Browser error reports to Sentry (#56). Empty: off.
NEXT_PUBLIC_SENTRY_DSN=

# --- Auth ------------------------------------------------------------------------------
# Required. openssl rand -hex 32
JEPARLA_JWT_SECRET=

# --- PostgreSQL 16 ---------------------------------------------------------------------
JEPARLA_DB_NAME=jeparla
# Required, three different values (openssl rand -hex 32 each).
JEPARLA_DB_ADMIN_PASSWORD=
JEPARLA_DB_MIGRATION_USER=jeparla_owner
JEPARLA_DB_MIGRATION_PASSWORD=
JEPARLA_DB_USER=jeparla_app
JEPARLA_DB_PASSWORD=

# Flyway: production applies migrations strictly in version order (application.yml allows out-of-order
# for development databases). Keep false; a new migration numbered below an applied one then stops the
# API start with a clear error instead of running silently out of order.
SPRING_FLYWAY_OUT_OF_ORDER=false

# --- Redis 7 ---------------------------------------------------------------------------
# Required. openssl rand -hex 32
JEPARLA_REDIS_PASSWORD=

# --- S3-compatible storage -------------------------------------------------------------
# local-s3 mode: these are also the root user and password of the S3 service.
# Access key: letters and digits, 3+ characters (e.g. jeparla). Secret: openssl rand -hex 32
JEPARLA_S3_ACCESS_KEY=jeparla
JEPARLA_S3_SECRET_KEY=
JEPARLA_S3_PUBLIC_BUCKET=jeparla-public
JEPARLA_S3_PRIVATE_BUCKET=jeparla-private
# Left unset in local-s3 mode: the compose file uses http://s3:9000, https://S3_DOMAIN and
# https://S3_DOMAIN/jeparla-public. For Cloudflare R2 (COMPOSE_PROFILES= empty) set all four:
# JEPARLA_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# JEPARLA_S3_PRESIGN_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# JEPARLA_S3_PUBLIC_URL=https://pub-<hash>.r2.dev
# JEPARLA_S3_REGION=auto
# and put the R2 API token's key pair into JEPARLA_S3_ACCESS_KEY / JEPARLA_S3_SECRET_KEY above.

# --- Optional ----------------------------------------------------------------------------
# Support contact named in notifications (#138) and on the site's /help page. Production should set one.
JEPARLA_SUPPORT_EMAIL=
JEPARLA_SUPPORT_URL=
# Operator named on the legal pages (/legal/*, #57): legal name, VOEN, registered address. Empty values show
# a visible "[owner's details]" marker. Rebuild the web image after a change (build args).
JEPARLA_OPERATOR_NAME=
JEPARLA_OPERATOR_TAX_ID=
JEPARLA_OPERATOR_ADDRESS=
# HMAC key of the seller declaration pseudonyms (#138, docs/legal/analysis.md); gen-secrets.sh fills it.
# Keep a copy outside the VM with the other secrets.
JEPARLA_PSEUDONYM_KEY=
# Shared secret of POST /internal/jobs/metal-prices (empty: endpoint off). openssl rand -hex 32
JEPARLA_INTERNAL_JOB_TOKEN=
# SMTP relay for emails (#131). Without a host, emails wait in the outbox.
JEPARLA_SMTP_HOST=
JEPARLA_SMTP_PORT=587
JEPARLA_SMTP_USERNAME=
JEPARLA_SMTP_PASSWORD=
JEPARLA_MAIL_FROM=
# Error tracking (#56). Empty: off.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
