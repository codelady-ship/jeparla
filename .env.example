# Jeparla environment variables.
#
#   cp .env.example .env
#
# .env is gitignored: real values live only there, on the server (chmod 600) and in GitHub Secrets.
# This file has names and safe local defaults only; every password and key is left empty on purpose.
#
# The values below target running the API on the host (./gradlew bootRun) against the Docker
# services. docker-compose.yml overrides the hostnames (postgres, redis, minio) for the backend container.
# Use letters and digits for passwords and keys: some of them are embedded in URLs.

# --- API ---------------------------------------------------------------------
# HTTP port of the API.
PORT=8080
# Allowed frontend origins for /api/**, comma-separated, exact (no "*").
JEPARLA_FRONTEND_ORIGIN=http://localhost:3000

# --- Auth (#34) ----------------------------------------------------------------
# Required. HS256 signing key of the access tokens, at least 32 bytes; the API does not start
# without it. Generate one: openssl rand -hex 32
JEPARLA_JWT_SECRET=
# Secure flag of the httpOnly refresh-token cookie. Keep true (browsers accept it on http://localhost).
JEPARLA_COOKIE_SECURE=true
# Reverse proxies (CIDR, comma-separated) whose X-Forwarded-For names the client (#132). Requests
# from anyone else are keyed by their own address. Empty trusts nothing. Production: the Caddy network.
JEPARLA_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# --- Support contact (#138) ---------------------------------------------------------
# Optional. Named at the end of every notification (in-app and email) that asks a seller to contact support.
# Unset: the notification points to the help page on the site, /{lang}/help in the app and
# JEPARLA_PUBLIC_SITE_URL/{lang}/help in the email (#167). Production must set one of them.
# JEPARLA_SUPPORT_EMAIL=
# Absolute http(s) URL, e.g. a support page or a WhatsApp link.
# JEPARLA_SUPPORT_URL=
# Public origin of the frontend (no path) for links in emails. Production: https://jeparla.az.
# JEPARLA_PUBLIC_SITE_URL=http://localhost:3000

# --- Email: verification and password reset links, notifications (#131, #138) ---------
# Optional. SMTP relay the email outbox is sent through (STARTTLS required; provider: backend/README.md,
# "E-poçt göndərmə"). Without a host nothing is sent: emails wait in the outbox and one-time links expire there.
# JEPARLA_SMTP_HOST=
# JEPARLA_SMTP_PORT=587
# JEPARLA_SMTP_USERNAME=
# Secret: the SMTP password or API key of the provider.
# JEPARLA_SMTP_PASSWORD=
# Required with a host. A sender on a domain verified at the provider (SPF and DKIM), e.g.
# Jeparla <no-reply@jeparla.az>.
# JEPARLA_MAIL_FROM=

# --- Metal prices (#43, #44) ------------------------------------------------------
# Optional. Shared secret of POST /internal/jobs/metal-prices (header X-Jeparla-Job-Token), used by
# .github/workflows/metal-prices-check.yml; at least 32 bytes (openssl rand -hex 32). Unset: the
# endpoint answers 404. The daily job itself runs from cron inside the API either way.
# JEPARLA_INTERNAL_JOB_TOKEN=

# --- PostgreSQL 16 (Flyway migrations, #32; roles, #165) ---------------------
# The postgres container creates the database and two roles on the first start of an empty volume
# (docker/postgres/10-jeparla-roles.sh). Three different passwords; the API never gets the superuser's.
JEPARLA_DB_NAME=jeparla
# Required. Superuser "postgres" of the container (maintenance only; not used by the API).
JEPARLA_DB_ADMIN_PASSWORD=
# Migration role: owns the schema, used by Flyway only (spring.flyway.user).
JEPARLA_DB_MIGRATION_USER=jeparla_owner
# Required.
JEPARLA_DB_MIGRATION_PASSWORD=
# Runtime role of the API: no superuser, owns nothing, may only read and insert the evidence tables
# (seller declarations, audit log). Must differ from the migration role; the API refuses to start otherwise.
JEPARLA_DB_USER=jeparla_app
# Required.
JEPARLA_DB_PASSWORD=
# JDBC URL the API connects to (localhost when the API runs outside Docker).
JEPARLA_DB_URL=jdbc:postgresql://localhost:5432/jeparla

# --- Redis 7 (cache and rate limit; the API runs without it) ------------------
# Rate-limit counters live here; while Redis is down the API counts in memory.
JEPARLA_REDIS_HOST=localhost
JEPARLA_REDIS_PORT=6379
# Required by the redis container.
JEPARLA_REDIS_PASSWORD=

# --- S3-compatible storage (MinIO locally, Cloudflare R2 in production) -------
# Locally the access key and secret are also the MinIO root user and password (secret: 8+ characters).
JEPARLA_S3_ENDPOINT=http://localhost:9000
# Endpoint written into presigned upload URLs (the browser opens them). Empty: JEPARLA_S3_ENDPOINT.
# Production (R2): the PRIVATE bucket needs a CORS rule that allows PUT from the frontend origin (uploads
# land there under staging/ and are copied to the public bucket only after their check, #154).
JEPARLA_S3_PRESIGN_ENDPOINT=
# MinIO accepts any region; Cloudflare R2 uses "auto".
JEPARLA_S3_REGION=us-east-1
# Required.
JEPARLA_S3_ACCESS_KEY=
# Required.
JEPARLA_S3_SECRET_KEY=
# Product images (public read).
JEPARLA_S3_PUBLIC_BUCKET=jeparla-public
# Private: photo uploads waiting for their check (staging/, lifecycle rule: delete after 1 day) and
# verification documents (short-lived signed URLs only). Must differ from the public bucket.
JEPARLA_S3_PRIVATE_BUCKET=jeparla-private
# Base URL browsers use for public images.
JEPARLA_S3_PUBLIC_URL=http://localhost:9000/jeparla-public
